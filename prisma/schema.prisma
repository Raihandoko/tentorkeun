generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  password      String
  role          String    @default("student") // student | tutor | admin
  phone         String?
  avatar        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  studentBookings Booking[] @relation("StudentBookings")
  tutorProfile    Tutor?
  reviews         Review[]
  sessions        Session[] @relation("StudentSessions")
}

model Tutor {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  nama              String
  gelar             String
  gender            String
  kota              String
  bio               String   @default("")
  mapel             String   // JSON array
  jenjang           String   // JSON array
  hargaPerSesi      Int
  hargaMin          Int
  hargaMax          Int
  sesiTersedia      String   // JSON array: ["online", "offline"]
  pengalamanTahun   Int      @default(0)
  sertifikasiABK    Boolean  @default(false)
  kondisiKhusus     String   @default("[]") // JSON array
  jadwal            String   @default("[]") // JSON array
  keahlian          String   @default("[]") // JSON array
  
  status            String   @default("pending") // pending | approved | rejected
  cvUrl             String?
  portofolioUrl     String?
  
  rating            Float    @default(0)
  ulasanCount       Int      @default(0)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  bookings          Booking[]
  sessions          Session[]
  reviews           Review[]
  verifications     TutorVerification[]
}

model TutorVerification {
  id            String   @id @default(cuid())
  tutorId       String
  tutor         Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  
  cvText        String
  ringkasan     String
  skor          Int
  rekomendasi   String
  kekuatan      String   // JSON array
  risiko        String   // JSON array
  pertanyaan    String   // JSON array
  saran         String   // JSON array
  
  verifiedBy    String?
  verifiedAt    DateTime?
  
  createdAt     DateTime @default(now())
}

model Booking {
  id            String   @id @default(cuid())
  studentId     String
  student       User     @relation("StudentBookings", fields: [studentId], references: [id], onDelete: Cascade)
  tutorId       String
  tutor         Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  
  mapel         String
  jenjang       String
  sessionType   String   // online | offline
  tanggal       DateTime
  durasi        Int      // menit
  harga         Int
  
  status        String   @default("pending") // pending | confirmed | completed | cancelled
  kebutuhan     String   @default("") // permintaan khusus dari match
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  sessions      Session[]
  payment       Payment?
}

model Payment {
  id            String   @id @default(cuid())
  bookingId     String   @unique
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  
  amount        Int
  method        String   // transfer | ewallet | cash
  status        String   @default("pending") // pending | paid | failed
  paidAt        DateTime?
  
  createdAt     DateTime @default(now())
}

model Session {
  id            String   @id @default(cuid())
  bookingId     String
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tutorId       String
  tutor         Tutor    @relation(fields: [tutorId], references: [id])
  studentId     String
  student       User     @relation("StudentSessions", fields: [studentId], references: [id])
  
  tanggal       DateTime
  durasi        Int
  catatan       String   @default("")
  
  reportId      String?  @unique
  report        Report?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Report {
  id                String   @id @default(cuid())
  sessionId         String   @unique
  session           Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  judul             String
  ringkasan         String
  capaian           String   // JSON array
  perluPerhatian    String   // JSON array
  materiDibahas     String   // JSON array
  rekomendasi       String   // JSON array
  penilaian         Int
  tren              String
  
  sentToParent      Boolean  @default(false)
  sentAt            DateTime?
  
  createdAt         DateTime @default(now())
}

model Review {
  id            String   @id @default(cuid())
  tutorId       String
  tutor         Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  studentId     String
  student       User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  rating        Int      // 1-5
  komentar      String
  
  createdAt     DateTime @default(now())
}

model StudyPlan {
  id            String   @id @default(cuid())
  studentId     String
  mapel         String
  jenjang       String
  target        String
  kelemahan     String
  
  judul         String
  jadwal        String   // JSON array
  latihan       String   // JSON array
  
  createdAt     DateTime @default(now())
}
